{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enableVulnerabilityAlerts"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "packageRules": [
    {
      "description": "Automerge non-major + security updates (minor/patch/digest/security)",
      "matchUpdateTypes": ["minor", "patch", "digest", "security"],
      "automerge": true
    },
    {
      "description": "Group CI GitHub Actions updates and use ci commits so they do not trigger releases",
      "matchManagers": ["github-actions"],
      "matchFileNames": [".github/**"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "semanticCommitType": "ci"
    }
  ],
  "lockFileMaintenance": {
    "automerge": true
  }
}
